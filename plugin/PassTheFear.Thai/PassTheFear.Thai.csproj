<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PassTheFear.Thai</AssemblyName>
    <RootNamespace>PassTheFear.Thai</RootNamespace>
    <Version>0.1.0</Version>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Interop assemblies are generated per machine; never warn about their missing docs. -->
    <NoWarn>$(NoWarn);CS0436;CS1701;CS1702</NoWarn>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Pass The Fear</GameDir>
  </PropertyGroup>

  <!-- BepInEx 6 IL2CPP core. Referenced straight out of the installed game so the plugin is
       always built against the exact loader it will run under. -->
  <ItemGroup>
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Unity.Common.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\0Harmony.dll" Private="false" />
  </ItemGroup>

  <!-- Il2CppInterop emits these on first launch. They keep the game's original namespaces
       (Wogame.*, GameFramework.Localization.*) — this build of BepInEx adds no Il2Cpp prefix. -->
  <ItemGroup>
    <Reference Include="$(GameDir)\BepInEx\interop\*.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Thai.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Kanit_sdf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
